{
  "schema_version": 1, "runtime": "python", "plugin_id": "example.user_transform", "plugin_version": "1.0.0",
  "nodes": [{
    "type_id": "example.python_user_transform", "version": "1.0.0", "display_name": "User Python Transform",
    "entrypoint": "user_transform:Transform", "execution": {"kind": "block", "stateful": false, "realtime_verified": false},
    "inputs": [{"id": "audio_in", "type": "audio.pcm@1", "required": true}],
    "outputs": [{"id": "main", "type": "audio.pcm@1"}, {"id": "side", "type": "audio.pcm@1"}],
    "format": {"sample_rates_hz": [16000,48000], "channels": [1,2,4]},
    "parameters": [
      {"id":"enabled","type":"bool","default":true},
      {"id":"repeat","type":"int","default":2,"minimum":1,"maximum":4,"step":1},
      {"id":"scale","type":"float","default":0.25,"minimum":0,"maximum":2},
      {"id":"polarity","type":"enum","default":"negative","choices":[{"value":"negative","label":"Negative"},{"value":"positive","label":"Positive"}]},
      {"id":"tag","type":"string","default":"user v1"},
      {"id":"coefficient","type":"path","default":"coefficient.txt","input_resource":true}
    ]
  }]
}
